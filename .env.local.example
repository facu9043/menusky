# Datos de tu proyecto de Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# URL pública del sitio (usada para generar los QR). En local dejá localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Solo para scripts server-side que necesiten saltar RLS (seed, admin scripts).
# NUNCA exponer en el cliente ni commitear.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
